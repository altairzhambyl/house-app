{
  "name": "house-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm --filter web typecheck",
    "setup": "pnpm install && pnpm --filter api setup",
    "test": "pnpm --filter web test",
    "test:prod": "vitest run --config tests/prod/vitest.config.ts"
  },
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "vitest": "^5.1.0"
  }
}
