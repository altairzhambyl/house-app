# Copy to apps/api/.env and fill in from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# .env is gitignored. NEVER commit real keys, and never send the service role
# key to the browser - it bypasses row-level security.

SUPABASE_URL=https://your-project-ref.supabase.co

# Server-side only. Full database access, ignores RLS policies.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
